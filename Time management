<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Time Tracker - Stats Edition</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
    /* पुराने स्टाइल्स */
    html, body { margin: 0; padding: 0; height: 100%; width: 100%; overflow-x: hidden; }
    body { font-family: 'Segoe UI', Arial; background:#f0f2f5; display: flex; flex-direction: column; align-items: center; }
    .container { background: white; width: 100%; min-height: 100vh; box-sizing: border-box; padding: 20px; display: flex; flex-direction: column; }
    .calendar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; }
    .nav-btn { cursor: pointer; font-size: 24px; padding: 10px; background: #eee; border-radius: 50%; border: none; }
    #monthYear { font-size: 22px; font-weight: bold; color: #007bff; }
    
    /* Streak & Stats Style */
    .top-info-row { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-bottom: 15px; }
    #streakDisplay { font-size: 16px; font-weight: bold; color: #ff5722; background: #fff3e0; padding: 5px 15px; border-radius: 20px; }
    
    /* Stats Box */
    .stats-container { width: 100%; background: #eef2f7; padding: 10px; border-radius: 12px; font-size: 13px; color: #444; display: flex; justify-content: space-around; text-align: center; }
    .stat-item b { color: #007bff; font-size: 15px; display: block; }

    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; margin-bottom: 20px; }
    .day-name { font-weight: bold; background: #e9ecef; padding: 10px; border-radius: 8px; font-size: 12px; text-align: center; }
    .day { padding: 15px 5px; background: #f8f9fa; border-radius: 10px; cursor: pointer; position: relative; font-size: 16px; text-align: center; border: 1px solid #eee; }
    .today { border: 2px solid #007bff; font-weight: bold; }
    .selected { background: #007bff !important; color: white; }
    .has-data::after { content: '★'; position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); color: #ffc107; font-size: 12px; }
    
    .input-section { margin-top: 10px; width: 100%; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
    th, td { border: 1px solid #ddd; padding: 10px; text-align: center; }
    th { background: #007bff; color: white; font-size: 13px; }
    input { width: 90%; padding: 6px; border: 1px solid #eee; font-size: 14px; }
    
    .btn-row { display: flex; gap: 10px; margin-bottom: 10px; }
    .action-btn { flex: 1; padding: 12px; border-radius: 8px; border: none; cursor: pointer; font-weight: bold; }
    .add-btn { background: #e7f3ff; color: #007bff; }
    .save-btn { background: #007bff; color: white; }
    .note-toggle-btn { width: 100%; background: #ffc107; color: #000; padding: 10px; border-radius: 8px; border: none; font-weight: bold; margin-bottom: 20px; }

    .chart-container { width: 100%; padding: 10px; background: #fff; border-radius: 12px; border: 1px solid #ddd; box-sizing: border-box; margin-top: auto; min-height: 250px; }
    .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center; }
    .modal-content { background: white; padding: 25px; border-radius: 15px; width: 85%; max-width: 350px; }
</style>
</head>
<body>

<div class="container">
    <div class="calendar-header">
        <button class="nav-btn" onclick="changeMonth(-1)">⬅️</button>
        <div id="monthYear"></div>
        <button class="nav-btn" onclick="changeMonth(1)">➡️</button>
    </div>
    
    <div class="top-info-row">
        <div id="streakDisplay">🔥 0 Days Streak</div>
        <div class="stats-container" id="statsDisplay">
            <div class="stat-item">Avg (Week)<b id="avgWeek">0h</b></div>
            <div class="stat-item">Best (Month)<b id="bestDay">-</b></div>
        </div>
    </div>
    
    <div class="calendar-grid" id="calendar"></div>
    
    <div class="input-section">
        <table>
            <thead><tr><th style="width: 40%;">Subject</th><th>Start</th><th>End</th><th>Total</th></tr></thead>
            <tbody id="tableBody"></tbody>
        </table>
        <div class="btn-row">
            <button class="action-btn add-btn" onclick="addRow()">+ Row</button>
            <button class="action-btn save-btn" onclick="saveData()">Save</button>
        </div>
        <button class="note-toggle-btn" onclick="openNoteModal()">📝 Add/View Note</button>
    </div>

    <div class="chart-container"><canvas id="dualChart"></canvas></div>
</div>

<div class="modal-overlay" id="modalOverlay">
    <div class="modal-content">
        <h4 id="popDate">Report</h4>
        <div id="modalOutput"></div>
        <div class="modal-btns" style="display:flex; gap:10px; margin-top:15px;">
            <button class="m-btn" style="flex:1; padding:10px; background:#6c757d; color:white; border:none; border-radius:5px;" onclick="closeModal()">बंद करें</button>
            <button class="m-btn" style="flex:1; padding:10px; background:#dc3545; color:white; border:none; border-radius:5px;" onclick="deleteData()">डिलीट</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="noteModalOverlay">
    <div class="modal-content">
        <h4 id="notePopDate">Note</h4>
        <textarea id="noteInput" style="width:100%; height:100px; padding:10px; box-sizing:border-box; border-radius:8px; border:1px solid #ccc;"></textarea>
        <div class="modal-btns" style="display:flex; gap:10px; margin-top:15px;">
            <button onclick="closeNoteModal()" style="flex:1; padding:10px; border:none; border-radius:5px;">Cancel</button>
            <button onclick="saveNote()" style="flex:1; padding:10px; background:#28a745; color:white; border:none; border-radius:5px;">Save</button>
        </div>
    </div>
</div>

<script>
let currentViewDate = new Date();
let currentSelectedDate = "";
let myChart;

function generateCalendar(){
    const calendar = document.getElementById("calendar");
    const year = currentViewDate.getFullYear();
    const month = currentViewDate.getMonth();
    const firstDay = new Date(year, month, 1).getDay();
    const lastDate = new Date(year, month + 1, 0).getDate();
    const monthNames = ["January","February","March","April","May","June","July","August","September","October","November","December"];
    document.getElementById("monthYear").innerHTML = monthNames[month] + " " + year;
    calendar.innerHTML = "";
    ["S","M","T","W","T","F","S"].forEach(d => { calendar.innerHTML += `<div class="day-name">${d}</div>`; });
    for(let i = 0; i < firstDay; i++) calendar.innerHTML += `<div></div>`;
    const realToday = new Date();
    for(let day = 1; day <= lastDate; day++){
        let key = `${year}-${month + 1}-${day}`;
        let hasData = (localStorage.getItem(key)) ? "has-data" : "";
        let isToday = (day === realToday.getDate() && month === realToday.getMonth() && year === realToday.getFullYear()) ? "today" : "";
        calendar.innerHTML += `<div class="day ${isToday} ${hasData}" onclick="clickDate(this, '${key}', ${day})">${day}</div>`;
    }
    updateChart();
    calculateStreak();
    calculateStats(); // नया फंक्शन कॉल
}

// --- NEW STATS LOGIC (Bina Purana Logic Change Kiye) ---
function calculateStats() {
    let year = currentViewDate.getFullYear();
    let month = currentViewDate.getMonth() + 1;
    let lastDate = new Date(year, month, 0).getDate();
    
    let monthTotal = 0;
    let monthDaysWithData = 0;
    let bestHrs = 0;
    let bestDayLabel = "-";

    // Monthly Best & Data Loop
    for (let i = 1; i <= lastDate; i++) {
        let data = JSON.parse(localStorage.getItem(`${year}-${month}-${i}`));
        if (data) {
            let dayTotal = data.reduce((s, r) => s + r.total, 0);
            monthTotal += dayTotal;
            monthDaysWithData++;
            if (dayTotal > bestHrs) {
                bestHrs = dayTotal;
                bestDayLabel = `${i} ${document.getElementById("monthYear").innerText.split(' ')[0].slice(0,3)} (${dayTotal}h)`;
            }
        }
    }

    // Weekly Average (Pichle 7 Dino Ka)
    let weekTotal = 0;
    let today = new Date();
    for(let i=0; i<7; i++) {
        let d = new Date(); d.setDate(today.getDate() - i);
        let key = `${d.getFullYear()}-${d.getMonth()+1}-${d.getDate()}`;
        let data = JSON.parse(localStorage.getItem(key));
        if(data) weekTotal += data.reduce((s, r) => s + r.total, 0);
    }

    document.getElementById("avgWeek").innerText = (weekTotal / 7).toFixed(1) + "h/day";
    document.getElementById("bestDay").innerText = bestDayLabel;
}

// --- Baki Sab Pehle Jaisa Hi Hai ---
function calculateStreak() {
    let streak = 0; let checkDate = new Date();
    let todayKey = `${checkDate.getFullYear()}-${checkDate.getMonth() + 1}-${checkDate.getDate()}`;
    if (!localStorage.getItem(todayKey)) checkDate.setDate(checkDate.getDate() - 1);
    while (true) {
        let key = `${checkDate.getFullYear()}-${checkDate.getMonth() + 1}-${checkDate.getDate()}`;
        if (localStorage.getItem(key)) { streak++; checkDate.setDate(checkDate.getDate() - 1); }
        else break;
    }
    document.getElementById("streakDisplay").innerText = `🔥 ${streak} Day Streak`;
}

function changeMonth(step) { currentViewDate.setMonth(currentViewDate.getMonth() + step); generateCalendar(); }

function addRow(sub="", start="", end="", total="") {
    const tbody = document.getElementById("tableBody");
    const row = tbody.insertRow();
    row.innerHTML = `<td><input type="text" class="sub" value="${sub}" placeholder="Sub"></td><td><input type="time" class="start" value="${start}" oninput="calcRow(this)"></td><td><input type="time" class="end" value="${end}" oninput="calcRow(this)"></td><td class="total-cell" style="font-weight:bold; color:#007bff;">${total || '0'}h</td>`;
}

function calcRow(input) {
    const row = input.parentElement.parentElement;
    const sVal = row.querySelector(".start").value;
    const eVal = row.querySelector(".end").value;
    if(sVal && eVal) {
        let s = sVal.split(':'); let e = eVal.split(':');
        let diff = (new Date(0,0,0,e[0],e[1]) - new Date(0,0,0,s[0],s[1])) / 3600000;
        if(diff < 0) diff += 24;
        row.querySelector(".total-cell").innerText = diff.toFixed(1) + "h";
    }
}

function clickDate(el, key, day) {
    document.querySelectorAll('.day').forEach(d => d.classList.remove('selected'));
    el.classList.add('selected'); currentSelectedDate = key;
    document.getElementById("tableBody").innerHTML = "";
    let saved = JSON.parse(localStorage.getItem(key));
    if(saved) { saved.forEach(r => addRow(r.sub, r.start, r.end, r.total)); showPopup(day, saved); }
    else addRow();
}

function saveData() {
    if(!currentSelectedDate) return alert("Select Date!");
    let data = [];
    document.querySelectorAll("#tableBody tr").forEach(row => {
        let sub = row.querySelector(".sub").value;
        let total = parseFloat(row.querySelector(".total-cell").innerText);
        if(sub) data.push({sub, start: row.querySelector(".start").value, end: row.querySelector(".end").value, total});
    });
    localStorage.setItem(currentSelectedDate, JSON.stringify(data));
    generateCalendar();
}

function updateChart() {
    const year = currentViewDate.getFullYear();
    const month = currentViewDate.getMonth();
    const lastDate = new Date(year, month + 1, 0).getDate();
    let labels = [], studyData = [];
    for (let i = 1; i <= lastDate; i++) {
        labels.push(i);
        let saved = JSON.parse(localStorage.getItem(`${year}-${month + 1}-${i}`));
        studyData.push(saved ? saved.reduce((s, r) => s + r.total, 0) : 0);
    }
    const ctx = document.getElementById('dualChart').getContext('2d');
    if (myChart) myChart.destroy();
    myChart = new Chart(ctx, {
        data: {
            labels: labels,
            datasets: [
                { type: 'bar', label: 'Hrs', data: studyData, backgroundColor: 'rgba(0, 123, 255, 0.4)', borderColor: '#007bff', borderWidth: 1 },
                { type: 'line', label: 'Trend', data: studyData, borderColor: '#dc3545', borderWidth: 2, tension: 0, fill: false }
            ]
        },
        options: { responsive: true, maintainAspectRatio: false, scales: { y: { min: 0, max: 24 } } }
    });
}

function openNoteModal() {
    if(!currentSelectedDate) return alert("Select Date!");
    document.getElementById("noteInput").value = localStorage.getItem('note_' + currentSelectedDate) || "";
    document.getElementById("noteModalOverlay").style.display = "flex";
}
function closeNoteModal() { document.getElementById("noteModalOverlay").style.display = "none"; }
function saveNote() {
    localStorage.setItem('note_' + currentSelectedDate, document.getElementById("noteInput").value);
    closeNoteModal(); generateCalendar();
}

function showPopup(day, data) {
    let sum = data.reduce((s, r) => s + r.total, 0);
    document.getElementById("popDate").innerText = "Date: " + day;
    document.getElementById("modalOutput").innerHTML = `Total: ${sum.toFixed(1)}h<br>Note: ${localStorage.getItem('note_'+currentSelectedDate) || '-'}`;
    document.getElementById("modalOverlay").style.display = "flex";
}
function closeModal() { document.getElementById("modalOverlay").style.display = "none"; }
function deleteData() { localStorage.removeItem(currentSelectedDate); closeModal(); generateCalendar(); }

generateCalendar();
</script>
</body>
</html>
